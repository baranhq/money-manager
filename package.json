{
  "name": "money-manager",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run licenses:check && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "playwright test",
    "licenses:update": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "postinstall": "node scripts/licenses.mjs --sync",
    "prebuild": "node scripts/licenses.mjs --sync"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.9.2",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.7",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
